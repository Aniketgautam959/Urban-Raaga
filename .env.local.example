MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/urban-raaga?retryWrites=true&w=majority

# Clerk (get from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# Cloudinary (get from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google Search Console ─────────────────────────────────────────────────
# Paste the content value from: GSC → Settings → Ownership verification → HTML tag
# e.g. <meta name="google-site-verification" content="XXXXX" /> → copy "XXXXX"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_gsc_verification_token

# ─── Google Indexing API (auto-index new artists) ──────────────────────────
# 1. Go to https://console.cloud.google.com → create/select project
# 2. Enable "Web Search Indexing API"
# 3. Create a Service Account → generate JSON key
# 4. Add the service account email as OWNER in GSC:
#    GSC → Settings → Users and permissions → Add user (Owner role)
# 5. Copy client_email and private_key from the downloaded JSON file
GOOGLE_INDEXING_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the entire private key here (keep the -----BEGIN/END----- lines, replace newlines with \n)
GOOGLE_INDEXING_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
